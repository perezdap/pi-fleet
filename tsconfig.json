{
  // Dev-only typecheck config.
  //
  // This resolves @earendil-works/pi-coding-agent and typebox from a local
  // node_modules/ (e.g. after `npm install` with pi's package linked/installed
  // as a dependency). If your pi installation lives elsewhere, either:
  //   1. `npm link @earendil-works/pi-coding-agent` (or symlink it) into
  //      node_modules/ here, or
  //   2. Copy this file to tsconfig.local.json, point "paths" at your pi
  //      install, and run `tsc -p tsconfig.local.json --noEmit`.
  //      tsconfig.local.json is gitignored so machine-specific paths never
  //      get committed.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["fleet/**/*.ts"]
}
